# Copy to .env and export these before starting (the app reads process.env directly).
# Example:  set -a; source .env; set +a; npm start

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Where the SQLite database lives.
DATA_DIR=data

# REQUIRED in production. 64 hex characters. Generate with: npm run keygen
# Encrypts uploaded notices at rest. Losing this key makes stored notices unreadable.
NOTICE_KEY=

# REQUIRED in production. Comma-separated name:password pairs. Each name appears in the audit log.
STAFF_USERS=maria:change-this-password,james:change-this-too

# IANA time zone of the service area. "Today" and shutoff countdowns use it.
TIMEZONE=America/New_York

# Data retention.
NOTICE_RETENTION_DAYS=0     # 0 = delete the notice image/text the moment a case closes
PII_RETENTION_DAYS=30       # days after close before name and phone are scrubbed
DRAFT_TTL_HOURS=24          # unsubmitted intakes are deleted after this long
TOKEN_TTL_DAYS=30           # how long a household's private link works

# Plan rules.
LARGE_BALANCE_CENTS=40000   # balances above this get a staff check
REMINDER_OFFSETS=3,1,0      # days before shutoff to send reminders

# Optional: read photos of notices and fall back to AI when pasted text cannot be parsed.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: send real texts. Without these, texts are printed to the server log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
STAFF_ALERT_PHONE=
# Needed to verify Twilio's inbound webhook signature. Must match the URL you give Twilio.
PUBLIC_BASE_URL=

# Set to 1 only when running behind a reverse proxy you control.
TRUST_PROXY=0
